{
  "manifest_version": 3,
  "name": "Doc Styler",
  "version": "1.1",
  "description": "Restyles Gemini, Claude, and ChatGPT to look like Google Docs.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "css/common.css",
        "css/chatgpt.css"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "css": [
        "css/common.css",
        "css/claude.css"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "css": [
        "css/common.css",
        "css/gemini.css"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "css/common.css",
        "images/header.png",
        "icons/icon48.png"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ]
    }
  ]
}